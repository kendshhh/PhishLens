# Local Python environment and generated files
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Private configuration; keep the example tracked
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/
output/
/chrome-extension/

# Local model files and private datasets
models/
datasets/private/

# Logs
*.log

# Temporary working files
/tmp/

# Local implementation dependencies and provisioned LLM weights (never commit).
/.runtime/
/extension/model-assets/

# Extension private signing keys (never commit). The approved key is kept outside
# the repository; these cover where it would land by accident, including the
# <folder>.pem file that Chrome's "Pack extension" writes next to the extension folder.
# The public key lives in extension/manifest.json (see docs/extension-identity.md).
/key.pem
/extension.pem
/extension/key.pem
# Generated static web app build (npm run web:build)
/web/dist/
