{
  "manifest_version": 3,
  "name": "PhishLens",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Analyze highlighted email text for possible phishing indicators.",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://phishlens-api-ocvt.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle PhishLens side panel"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
