# Local development only. Keep hosted staging and production credentials in their
# protected Render/GitHub stores, not in a local .env file.

# Local PostgreSQL/Neon development database. Use the phishlens_dev database on
# the development branch; never use production credentials here.
DATABASE_URL=

# The API reports this environment from /version. Local default is development.
APP_ENV=development

# mock, gemini, local (legacy DistilBERT), or tfidf. CI can use mock.
# Set tfidf for the matching server-owned v12a saved-report workflow.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional local model cache. Defaults to the ignored models/ directory.
MODEL_PATH=

# Hosted staging only. Configure these in the protected Render service, not here:
# STAGING_DATABASE_HOST=
# STAGING_APP_DATABASE_ROLE=phishlens_staging_app
# STAGING_MIGRATION_DATABASE_URL=
# RENDER_STAGING_API_KEY belongs only in the protected GitHub staging environment.

# Saved-report authentication rollout (demo is shared, not private user storage).
# Enable neon only after migration 0004 and isolated authentication tests pass.
REPORT_AUTH_MODE=demo
# Branch-specific HTTPS Auth URL; not a Postgres connection string.
NEON_AUTH_BASE_URL=
