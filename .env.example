# Copy this file to .env for local development. .env is ignored by Git.
# Keep hosted staging and production credentials in their protected Render/
# GitHub stores; never copy them into a local .env file.

# Required by the API and migrations. Use a local or dedicated development
# PostgreSQL/Neon target (phishlens_dev); never use staging or production here.
DATABASE_URL=

# The API reports this environment from /version. Local default is development.
APP_ENV=development

# Supported modes: mock, gemini, local (legacy DistilBERT), or tfidf.
# gemini requires both GEMINI_API_KEY and GEMINI_MODEL. mock needs no provider key.
# Use tfidf for the matching server-owned v12a saved-report workflow.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional local model cache for local inference. Defaults to ignored models/.
MODEL_PATH=

# Hosted staging only. Set these on the protected Render staging service,
# never in this local file. DATABASE_URL there must use the staging app role.
# STAGING_DATABASE_HOST=
# STAGING_APP_DATABASE_ROLE=phishlens_staging_app
# STAGING_MIGRATION_DATABASE_URL=

# GitHub Actions-only scopes; do not set these in local .env:
# RENDER_STAGING_API_KEY is a secret in the GitHub `staging` environment.
# RENDER_STAGING_SERVICE_ID and STAGING_BASE_URL are GitHub repository variables.
# RENDER_OBSERVER_API_KEY is a secret in the GitHub `production-observer` environment.

# Render supplies platform values such as PORT and RENDER_GIT_COMMIT;
# PYTHON_VERSION is Render build configuration. None belong in local .env.

# Saved-report authentication rollout (demo is shared, not private user storage).
# Enable neon only after migration 0004 and isolated authentication tests pass.
REPORT_AUTH_MODE=demo
# Branch-specific HTTPS Auth URL; not a Postgres connection string.
NEON_AUTH_BASE_URL=
