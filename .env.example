# Development PostgreSQL connection for application queries and current Alembic migrations
# Format: postgresql://USER:URL_ENCODED_PASSWORD@HOST/phishlens_dev?sslmode=require
DATABASE_URL=

# Planned direct connection for CI migrations; current Alembic setup reads DATABASE_URL
MIGRATION_DATABASE_URL=

# Backend security secret
SECRET_KEY=

# Local Hugging Face cache directory (default: ignored models/).
# Install backend/requirements-ai.txt, then prepare weights with:
# python scripts/ai_smoke.py --mode local --download-model
MODEL_PATH=

# Public backend address
BACKEND_API_URL=

# Proposed development settings
APP_ENV=development
# mock, gemini (Google-hosted Gemini or Gemma), or local (pinned DistilBERT)
AI_MODE=mock

GEMINI_API_KEY=
GEMINI_MODEL=
# Prompt version is assigned by backend/ai/prompts.py, rather than this environment.

