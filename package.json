  "bugs": {
    "url": "https://github.com/kendshhh/PhishLens/issues"
  },
  "homepage": "https://github.com/kendshhh/PhishLens#readme",
  "devDependencies": {
    "better-auth": "1.7.18",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "@neon/auth": "0.8.2"
  }
