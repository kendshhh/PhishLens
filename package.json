{
  "name": "phishlens",
  "version": "1.0.0",
  "type": "module",
  "description": "PhishLens is an AI-powered phishing email detection and analysis\r system. It helps users identify suspicious emails, understand\r risk indicators, and manage saved analysis reports.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test extension/tests/*.test.mjs",
    "test:browser": "node scripts/browser_acceptance.mjs",
    "lint": "eslint extension/",
    "validate": "python scripts/validate_extension.py",
    "package": "python scripts/package_extension.py",
    "phishlens": "node scripts/phishlens.mjs",
    "doctor": "node scripts/phishlens.mjs doctor",
    "model:check": "node scripts/phishlens.mjs model-check",
    "test:accounts": "node scripts/test_account_ui.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kendshhh/PhishLens.git"
  },
  "keywords": [],
  "author": "",
